{
  "name": "orangehrm-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright and TypeScript automation framework for OrangeHRM",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test --project=regression",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityapatel-dev/orangehrm-playwright-automation.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "api-testing",
    "qa",
    "sdet"
  ],
  "author": "Aditya Patel",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Adityapatel-dev/orangehrm-playwright-automation/issues"
  },
  "homepage": "https://github.com/Adityapatel-dev/orangehrm-playwright-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}